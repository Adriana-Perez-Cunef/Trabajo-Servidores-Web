PORT=3000
NODE_ENV=development

# Base de datos (en Docker el host es "db")
DATABASE_URL=postgres://hive:hive@localhost:5432/hive

# Cambia este valor por una cadena larga y aleatoria
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=2h

# Datos de demostración (eventos y usuarios de ejemplo) al arrancar con la BD vacía
SEED_DEMO_DATA=true
ADMIN_PASSWORD=HiveAdmin123!
